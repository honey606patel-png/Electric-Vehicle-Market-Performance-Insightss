      <aliases enabled='yes' />
      <column caption='Annual Sales Units' datatype='integer' name='[Annual_Sales_Units]' role='measure' type='quantitative' />
      <column caption='Average Price USD' datatype='integer' name='[Average_Price_USD]' role='measure' type='quantitative' />
      <column caption='Battery Capacity kWh' datatype='real' name='[Battery_Capacity_kWh]' role='measure' type='quantitative' />
      <column caption='Battery Chemistry' datatype='string' name='[Battery_Chemistry]' role='dimension' type='nominal' />
      <column caption='Range Efficiency (km/kWh)' datatype='real' name='[Calculation_0568233333133312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Driving_Range_km] / [Battery_Capacity_kWh]' />
      </column>
      <column caption='Total Revenue($)' datatype='integer' name='[Calculation_0568233333420033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Annual_Sales_Units] * [Average_Price_USD]' />
      </column>
      <column caption='Market Share%' datatype='real' name='[Calculation_0568233333645314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Annual_Sales_Units]) / SUM({ SUM([Annual_Sales_Units]) })' />
      </column>
      <column caption='Satisfaction Category' datatype='string' name='[Calculation_0568233333731331]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Customer_Rating] &gt;= 4.5 THEN &apos;High Satisfaction (4.5+)&apos;&#13;&#10;ELSEIF [Customer_Rating] &gt;= 4.0 THEN &apos;Moderate Satisfaction (4.0 - 4.4)&apos;&#13;&#10;ELSE &apos;Standard Satisfaction (&lt;4.0)&apos;&#13;&#10;END' />
      </column>
      <column caption='Customer Rating' datatype='real' name='[Customer_Rating]' role='measure' type='quantitative' />
      <column caption='Driving Range km' datatype='integer' name='[Driving_Range_km]' role='measure' type='quantitative' />
      <column datatype='string' name='[Manufacturer]' role='dimension' type='nominal' />
