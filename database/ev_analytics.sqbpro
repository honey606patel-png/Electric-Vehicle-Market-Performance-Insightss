<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="ev_analytics.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2614"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="BatteryTech" custom_title="0" dock_id="3" table="4,11:mainBatteryTech"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="BatteryTech" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="2" value="98"/><column index="3" value="119"/><column index="4" value="141"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Create Tables
CREATE TABLE Manufacturers (
    manufacturer_id INTEGER PRIMARY KEY AUTOINCREMENT,
    manufacturer_name TEXT NOT NULL,
    country_of_origin TEXT NOT NULL
);

CREATE TABLE BatteryTech (
    battery_tech_id INTEGER PRIMARY KEY AUTOINCREMENT,
    chemistry_type TEXT NOT NULL,
    avg_lifespan_years INTEGER,
    energy_density_wh_kg REAL
);

CREATE TABLE Vehicles (
    vehicle_id INTEGER PRIMARY KEY AUTOINCREMENT,
    model_name TEXT NOT NULL,
    manufacturer_id INTEGER,
    category TEXT NOT NULL,
    battery_tech_id INTEGER,
    battery_capacity_kwh REAL NOT NULL,
    driving_range_km REAL NOT NULL,
    base_price_usd REAL NOT NULL,
    FOREIGN KEY (manufacturer_id) REFERENCES Manufacturers(manufacturer_id),
    FOREIGN KEY (battery_tech_id) REFERENCES BatteryTech(battery_tech_id)
);

CREATE TABLE SalesPerformance (
    sale_id INTEGER PRIMARY KEY AUTOINCREMENT,
    vehicle_id INTEGER,
    sale_year INTEGER NOT NULL,
    region TEXT NOT NULL,
    units_sold INTEGER NOT NULL,
    customer_rating REAL CHECK (customer_rating BETWEEN 1.0 AND 5.0),
    FOREIGN KEY (vehicle_id) REFERENCES Vehicles(vehicle_id)
);

-- 2. Populate Sample Records
